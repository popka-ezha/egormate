<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сайтик</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #6d6552;
            color: #30626b;
            text-align: center;
            padding: 50px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        h1 {
            color: #30626b;
            font-size: 3em;
            margin-bottom: 20px;
        }
        .message {
            color: #30626b;
            font-size: 1.5em;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Сайтик</h1>
        <p class="message">ПУПУППУПУПУ</p>
        <p>Серверное время: <span id="datetime"></span></p>
    </div>

    <script>
        document.getElementById('datetime').textContent = new Date().toLocaleString('ru-RU');
    </script>
</body>
</html>
